DirectoryIndex index.php

# ----------------------------------------------------------------------
# 1. Force PHP 8.4 / 8.3 Execution on cPanel, CloudLinux & LiteSpeed
# ----------------------------------------------------------------------
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
  AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
  AddHandler application/x-httpd-alt-php84___lsphp .php .php8 .phtml
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
  AddHandler application/x-httpd-alt-php83 .php .php8 .phtml
  AddHandler application/x-httpd-alt-php83___lsphp .php .php8 .phtml
</IfModule>

# ----------------------------------------------------------------------
# 2. Apache URL Rewriting & Front Controller
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # ══════════════════════════════════════════════════════════
    # SECURITY LAYER 1: Block Access to Sensitive Files
    # ══════════════════════════════════════════════════════════
    <FilesMatch "\.(env|git|cpanel\.yml|sql|log|bak|old|swp|dist|orig|save|tmp|DS_Store)$">
        Require all denied
    </FilesMatch>

    <FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|\.gitignore|\.gitattributes|\.editorconfig|\.npmrc|artisan|berandadigital\.sql|phpinfo\.php|design\.md|README\.md)$">
        Require all denied
    </FilesMatch>

    # ══════════════════════════════════════════════════════════
    # SECURITY LAYER 2: Block Direct Access to Sensitive Dirs
    # ══════════════════════════════════════════════════════════
    RewriteRule ^storage(/|$) - [F,L]
    RewriteRule ^database(/|$) - [F,L]
    RewriteRule ^bootstrap(/|$) - [F,L]
    RewriteRule ^vendor(/|$) - [F,L]
    RewriteRule ^config(/|$) - [F,L]
    RewriteRule ^resources(/|$) - [F,L]
    RewriteRule ^app(/|$) - [F,L]
    RewriteRule ^routes(/|$) - [F,L]
    RewriteRule ^tests(/|$) - [F,L]
    RewriteRule ^node_modules(/|$) - [F,L]

    # ══════════════════════════════════════════════════════════
    # SECURITY LAYER 3: Block Common Attack Patterns
    # ══════════════════════════════════════════════════════════
    # Block path traversal attempts
    RewriteCond %{QUERY_STRING} (\.\./|\.\.) [NC]
    RewriteRule .* - [F,L]

    # Block null byte injection
    RewriteCond %{QUERY_STRING} %00 [NC]
    RewriteRule .* - [F,L]

    # Block common exploit scanners
    RewriteCond %{REQUEST_URI} (wp-admin|wp-login|wp-content|xmlrpc\.php) [NC]
    RewriteRule .* - [R=404,L]

    # ══════════════════════════════════════════════════════════
    # SECURITY LAYER 4: Apache Security Headers (Fallback)
    # ══════════════════════════════════════════════════════════
    <IfModule mod_headers.c>
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-XSS-Protection "1; mode=block"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always unset X-Powered-By
        Header always unset Server
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Fallback to public folder for static assets if missing in root
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ----------------------------------------------------------------------
# 3. Disable Server Signature & Directory Listing
# ----------------------------------------------------------------------
ServerSignature Off
